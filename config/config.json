{
  "development": {
    "username": null,
    "password": null,
    "database": "proyecto_backend",
    "host": "127.0.0.1",
    "dialect": "sqlite",
    "storage": "./proyecto-backend.sqlite3"
  },
  "test": {
    "username": "root",
    "password": null,
    "database": "database_test",
    "host": "127.0.0.1",
    "dialect": "mysql"
  },
  "production": {
    "username": "${{Postgres.DATABASE_USER}}",
    "password": "${{Postgres.DATABASE_PASSWORD}}",
    "database": "/var/lib/postgresql/data/pgdata",
    "host": "postgres.railway.internal",
    "dialect": "postgres",
    "dialectOptions": {
      "ssl": {
        "require": true,
        "rejectUnauthorized": false
      }
    },
    "DATABASE_URL": "${{ Postgres.DATABASE_URL }}",
    "port": "5432"
  }
}
