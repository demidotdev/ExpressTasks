{
  "development": {
    "username": null,
    "password": null,
    "database": "proyecto_backend",
    "host": "127.0.0.1",
    "dialect": "sqlite",
    "storage": "./proyecto-backend.sqlite3"
  },
  "test": {
    "username": "root",
    "password": null,
    "database": "database_test",
    "host": "127.0.0.1",
    "dialect": "mysql"
  },
  "production": {
    "username": "${{RAILWAY_POSTGRES_USER}}",
    "password": "${{RAILWAY_POSTGRES_PASSWORD}}",
    "database": "${{RAILWAY_POSTGRES_DB}}",
    "host": "${{RAILWAY_POSTGRES_HOST}}",
    "dialect": "${{RAILWAY_POSTGRES_DIALECT}}",
    "dialectOptions": {
      "ssl": {
        "require": true,
        "rejectUnauthorized": false
      }
    },
    "url": "${{RAILWAY_PRIVATE_DOMAIN}}",
    "port": "${{RAILWAY_POSTGRES_PORT}}"
  }
}
