  "production": {
    "username": "${[PGUSER]}",
    "password": "${[PGPASSWORD]}",
    "host": "postgres.railway.internal",
    "database": "${{PGDATABASE}}",
    "databaseUrl": "${{DATABASE_URL}}",
    "port": 5432,
    "dialect": "postgres",
    "dialectOptions": {
      "ssl": {
        "rejectUnauthorized": false
      }
    }
  }
}
