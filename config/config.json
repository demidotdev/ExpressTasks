{
  "development": {
    "username": null,
    "password": null,
    "database": "proyecto_backend",
    "host": "localhost",
    "dialect": "sqlite",
    "storage": "./proyecto-backend.sqlite3"
  },
  "test": {
    "username": "root",
    "password": null,
    "database": "database_test",
    "host": "127.0.0.1",
