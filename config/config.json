{
  "development": {
    "username": null,
    "password": null,
    "database": "proyecto_backend",
    "host": "127.0.0.1",
    "dialect": "sqlite",
    "storage": "./proyecto-backend.sqlite3"
  },
  "test": {
    "username": "root",
    "password": null,
    "database": "database_test",
    "host": "127.0.0.1",
    "dialect": "mysql"
  },
  "production": {
    "username": "${{Postgres.DATABASE_USER}}",
    "password": "${{Postgres.DATABASE_PASSWORD}}",
    "database": "${{Postgres.DATABASE_NAME}}",
    "host": "${{Postgres.DATABASE_HOST}}",
    "dialect": "${{Postgres.DATABASE_DIALECT}}",
    "dialectOptions": {
      "ssl": {
        "require": true,
        "rejectUnauthorized": false
      }
    },
    "url": "${{Postgres.DATABASE_PRIVATE_URL}}",
    "port": "${{Postgres.DATABASE_PORT}}"
  }
}
